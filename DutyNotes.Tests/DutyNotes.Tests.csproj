<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the parts of Duty Notes that don't need the game: settings, navigation, and import/export.
    A plain console program, so it needs no NuGet packages. Run it from the repository root with the dotnet run command, giving it the DutyNotes.Tests project.
    The exit code is 0 when every check passes, 1 otherwise.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Same assembly name as the plugin on purpose: saved settings record "DutyNotes.Configuration, DutyNotes",
         and the serialization tests need those type names to resolve. -->
    <AssemblyName>DutyNotes</AssemblyName>
    <RootNamespace>DutyNotes.Tests</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Override with /p:DalamudLibPath=... if your XIVLauncher lives elsewhere. -->
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(AppData)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the files that don't depend on the game. Anything that touches Dalamud services or ImGui can't run here. -->
    <Compile Include="..\DutyNotes\Configuration.cs" Link="Plugin\Configuration.cs" />
    <Compile Include="..\DutyNotes\Sharing.cs" Link="Plugin\Sharing.cs" />
    <Compile Include="..\DutyNotes\HelpCommands.cs" Link="Plugin\HelpCommands.cs" />

  </ItemGroup>

  <ItemGroup>
    <Reference Include="Dalamud"><HintPath>$(DalamudLibPath)Dalamud.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(DalamudLibPath)Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>

</Project>
