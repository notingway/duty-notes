<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <!--
    The Dalamud.NET.Sdk finds Dalamud and its libraries (ImGui, Lumina, Newtonsoft.Json) by itself, and DalamudPackager builds the
    plugin manifest (DutyNotes.json) from the properties below, so there is no hand-written manifest file.

    Never change AssemblyName, RootNamespace or the plugin's InternalName (which is the AssemblyName) without a settings migration:
    saved settings record type names such as "DutyNotes.SheetNode, DutyNotes". See CLAUDE.md, "Invariants and rules".
  -->

  <PropertyGroup>
    <AssemblyName>DutyNotes</AssemblyName>
    <RootNamespace>DutyNotes</RootNamespace>
    <Version>0.1.2.0</Version>

    <!-- The language settings the code was written with (the SDK does not turn these on). -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Manifest fields -->
    <Author>notingway</Author>
    <Name>Duty Notes</Name>
    <Punchline>Per-duty overlay for mechanics, mitigation and notes.</Punchline>
    <Description>An in-game overlay that holds your notes for a duty: a table of mechanics, the mitigation and healing actions to use for each (shown as icons), notes, and free text. Encounters can be tied to a duty and a job so the right one appears when you enter, with phases you can step through from buttons or macros.</Description>
    <RepoUrl>https://github.com/notingway/duty-notes</RepoUrl>
    <Tags>duty;notes;raid;mitigation;overlay</Tags>

    <!--
      The icon and the screenshot, by address. They have to be in the manifest inside latest.zip as well as in the plugin repository index:
      once a plugin is installed, Dalamud reads its icon from the manifest that came in the zip, and without these the installed plugin has no icon.
    -->
    <IconUrl>https://raw.githubusercontent.com/notingway/duty-notes/main/images/icon.png</IconUrl>
    <ImageUrls>https://raw.githubusercontent.com/notingway/duty-notes/main/images/image1.png</ImageUrls>
  </PropertyGroup>

</Project>
